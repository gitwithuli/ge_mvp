<div class="p-4">
  <h1 class="text-xl font-bold mb-4">My Listings</h1>
</div>

<% if @listings.blank? %>
  <div class="p-6 text-center text-gray-500">
    You haven’t posted anything yet.
    <div class="mt-3">
      <%= link_to "Post your first listing", new_listing_path, class: "px-4 py-2 border rounded-xl inline-block" %>
    </div>
  </div>
<% else %>
  <div class="p-3 grid grid-cols-2 gap-3 md:grid-cols-3">
    <% @listings.each do |l| %>
      <div class="relative rounded-2xl overflow-hidden border">
        <% if l.promoted_until&.> Time.current %>
          <span class="absolute left-2 top-2 z-10 bg-yellow-300/90 text-xs px-2 py-0.5 rounded">Promoted</span>
        <% end %>

        <%= link_to l, class: "block" do %>
          <% if l.photos.attached? %>
            <%= image_tag l.photos.first.variant(resize_to_fill: [600, 400]), loading: :lazy, class: "w-full h-auto" %>
          <% else %>
            <div class="w-full aspect-[3/2] bg-gray-100"></div>
          <% end %>
          <div class="p-3">
            <div class="font-semibold"><%= number_to_currency((l.price_cents || 0)/100.0, unit: '₾') %></div>
            <div class="text-sm text-gray-700 truncate"><%= l.title %></div>
            <div class="text-xs text-gray-500"><%= [l.location&.name, l.category&.name].compact.join(" · ") %></div>
          </div>
        <% end %>

        <div class="p-3 pt-0 flex gap-2">
          <%= link_to "Edit", edit_listing_path(l), class: "px-3 py-1 border rounded-xl" %>
          <%= button_to "Promote 7 days", promote_listing_path(l), method: :post, class: "px-3 py-1 border rounded-xl" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
